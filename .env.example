# WhatsApp API Configuration
# Required for WhatsApp integration to work properly. Shared by the
# WhatsPoints service (message sending AND sender registration) - there's
# only one instance, so registration doesn't get its own credentials.

# WhatsApp API Base URL (without /send-message endpoint)
WHATSAPP_API_URL=http://xx.xx.xx.xx

# Credentials read by the Vercel serverless functions (api/whatsapp-send.js,
# api/wa-sender-register.js).
WHATSAPP_USERNAME=admin
WHATSAPP_PASSWORD=your_secure_password

# Same credentials, but this is the pair name vite.config.ts's dev proxy
# (the '/api/whatsapp' rewrite, used by npm run dev) reads. Keep both pairs
# in sync - yes, this is two names for the same value.
WHATSAPP_API_USERNAME=admin
WHATSAPP_API_PASSWORD=your_secure_password

# WhatsApp API Timeout (in milliseconds)
WHATSAPP_API_TIMEOUT=10000

# Frontend Environment Variables (prefixed with VITE_)
# These are exposed to the browser, so don't put sensitive data here

# Enable/disable WhatsApp integration
VITE_WHATSAPP_ENABLED=true

# Development mode (logs messages instead of sending them)
VITE_WHATSAPP_DEVELOPMENT_MODE=false

# Notification settings
VITE_WHATSAPP_NOTIFY_ORDER_CREATED=true
VITE_WHATSAPP_NOTIFY_ORDER_COMPLETED=true

# Development settings (for local development only)
VITE_WHATSAPP_API_URL=http://localhost:8080
VITE_WHATSAPP_API_USERNAME=admin
VITE_WHATSAPP_API_PASSWORD=your_secure_password
VITE_WHATSAPP_API_TIMEOUT=10000

# Google Sign-In (optional)
# OAuth 2.0 Web Client ID from Google Cloud Console > Credentials.
# Add your app origins (e.g. http://localhost:8080 and your production domain)
# to "Authorized JavaScript origins". Leave blank to hide the Google button.
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# Public laundry website. Empty fields retain the source defaults or honest empty states.
# Replace the temporary source contact with an active outlet number before taking live orders.
VITE_LAUNDRY_NAME=Laundry Mr Andy
VITE_LAUNDRY_WHATSAPP=628213194417
VITE_LAUNDRY_ADDRESS=
VITE_LAUNDRY_EMAIL=
VITE_LAUNDRY_HOURS=
VITE_LAUNDRY_INSTAGRAM=
# An explicitly chosen Supabase store ID publishes its active catalog and public contact fields.
VITE_PUBLIC_STORE_ID=
VITE_SITE_URL=https://pos.fahrudina.my.id
